# Local environment for AdaptiveInspect AI.
# Copy to backend/.env and fill in real values. Do not commit real secrets.

# Use the Supabase transaction pooler for normal API traffic.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true

# Use the Supabase session pooler or direct connection for schema initialization and migrations.
DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/postgres

# Local SQLite fallback when cloud credentials are not configured:
# DATABASE_URL=sqlite:///adaptive_inspect.db
